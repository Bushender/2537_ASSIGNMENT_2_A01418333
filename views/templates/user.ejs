<tr>
    <td><%= user.name %></td>
    <td><%= user.email %></td>
    <td><%= user.user_type || 'user' %></td>
    <td>
        <% if (user.user_type === 'admin') { %>
            <a href="/demoteUser?email=<%= user.email %>" class="btn btn-warning btn-sm">Demote</a>
        <% } else { %>
            <a href="/promoteUser?email=<%= user.email %>" class="btn btn-success btn-sm">Promote</a>
        <% } %>
    </td>
</tr>