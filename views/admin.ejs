<%- include('templates/header') %>

<h1>Admin Panel</h1>
<p>All Users:</p>

<table class="table table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Type</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        <% for (let i = 0; i < users.length; i++) { %>
            <%- include('templates/user', { user: users[i] }) %>
        <% } %>
    </tbody>
</table>

<%- include('templates/footer') %>